{
  "name": "agent-ville",
  "version": "2.0.0",
  "description": "Watch your Claude Code and Codex agents live as dwarves in an isometric village — approve requests, send orders, track costs.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "dashboard",
    "hooks",
    "visualization",
    "pixi"
  ],
  "author": "Simon Streblow",
  "license": "MIT",
  "homepage": "https://github.com/StrSimon/AgentVille",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrSimon/AgentVille.git"
  },
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "agentville": "bin/agentville.mjs",
    "agent-ville": "bin/agentville.mjs"
  },
  "files": [
    "bin/",
    "hook/",
    "dist/",
    "server/**/*.mjs",
    "!server/**/*.test.mjs"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "bridge": "node bin/agentville.mjs start --no-open --no-setup",
    "start": "npm run build && node bin/agentville.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test server/*.test.mjs server/core/*.test.mjs",
    "test:client": "vitest run",
    "test:coverage": "node --test --experimental-test-coverage server/*.test.mjs server/core/*.test.mjs && vitest run --coverage",
    "icons": "node scripts/make-icons.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "dev.agentville.app",
    "productName": "AgentVille",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "!desktop/**/*.test.mjs",
      "bin/**/*",
      "hook/**/*",
      "dist/**/*",
      "server/**/*.mjs",
      "!server/**/*.test.mjs",
      "!server/data/**"
    ],
    "asarUnpack": [
      "hook/**/*"
    ],
    "extraResources": [
      {
        "from": "build/tray",
        "to": "tray"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Simon Streblow <https://github.com/StrSimon>",
      "synopsis": "Your Claude Code & Codex agents as a living dwarf village"
    }
  }
}
